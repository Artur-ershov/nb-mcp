# Required: Google Gemini API key (this is what powers "nano banana").
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash-image (the classic "nano banana").
# Other options:
#   gemini-3-pro-image    -> Nano Banana Pro  (higher quality, slower, pricier)
#   gemini-3.1-flash-image -> Nano Banana 2   (newer flash model)
# NB_MODEL=gemini-2.5-flash-image
